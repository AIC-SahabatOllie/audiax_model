# ============================================================
# .dockerignore — MLOps Best Practice (Lean Build Context)
# ============================================================
.git
.gitignore
.github
.idea
.vscode
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
htmlcov

# Experiments & Notebooks (Eksperimen tidak perlu masuk container produksi)
experiments/
*.ipynb
*.ipynb_checkpoints

# Datasets & Sample data
Dataset/
sample_dataset/
*.wav
*.mp3
*.flac

# Local Virtual Environments
.venv/
venv/
env/

# Tests & Docs
tests/
docs/

# Temporary files
tmp/
temp/
*.log

# Salinan checkpoint yang tercecer di root repo (361 MB). Yang dipakai image
# adalah ai/weights/beats_finetuned.pt; salinan root cuma memperlambat build
# karena ikut dikirim ke daemon sebagai build context.
# Pola ini TIDAK ber-anchor ganda, jadi ai/weights/*.pt tetap ikut ter-copy.
beats_finetuned.pt
